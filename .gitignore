# Data. Raw snapshots under data/raw/ ARE committed: they are the
# immutable, checksummed provenance record every run depends on (v0.2 Phase
# 1, data/README.md). Processed output is regenerated deterministically.
data/processed/
!data/processed/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store

# Node (for the later Next.js frontend)
node_modules/

# Source-preservation archive runtime evidence (ADR-0022): blobs, records, metadata
# and advisory output are local, never committed. Definitions and docs are.
data/source_archive/runtime/
.claude/settings.local.json
